# GEC Admin Portal — environment template (copy to .env.local; never commit real values)

# 1. NEON POSTGRESQL DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 2. AWS BEDROCK (only used by the legacy standalone bot / AI routes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_FALLBACK_MODEL_ID=

# 3. WHATSAPP CLOUD API (outbound: admin replies + payment-receipt fallback)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>
WEBHOOK_VERIFY_TOKEN=

# 4. APP CONFIG
NEXT_PUBLIC_APP_URL=https://goraiequestriancentre.vercel.app

# 5. ADMIN DESK AUTH — REQUIRED. If ADMIN_PASSWORD is unset, /admin stays locked.
ADMIN_PASSWORD=
# Optional signing key (32+ random chars). Defaults to ADMIN_PASSWORD.
AUTH_SECRET=

# 6. N8N SINGLE-SOURCE MESSAGING (defaults shown; override only if n8n moves)
N8N_PAYMENT_WEBHOOK_URL=https://<your-n8n-host>/webhook/payment-webhook
N8N_REGISTRATION_WEBHOOK_URL=https://<your-n8n-host>/webhook/registration-submit
N8N_WHATSAPP_INGRESS_URL=https://<your-n8n-host>/webhook/whatsapp-meta-ingress
# disabled (default, n8n owns inbound WhatsApp) | forward (relay to n8n) | standalone (legacy bot, emergency only)
WHATSAPP_WEBHOOK_MODE=disabled

# Razorpay (Standard Checkout). KEY_SECRET and WEBHOOK_SECRET are server-only.
RAZORPAY_KEY_ID=<rzp_test_or_live_key_id>
RAZORPAY_KEY_SECRET=<razorpay_key_secret>
RAZORPAY_WEBHOOK_SECRET=<webhook_secret_set_in_razorpay_dashboard>

# Shared secret the portal sends to n8n webhooks (X-GEC-Internal-Secret). Same value as the n8n Variable GEC_INTERNAL_SECRET.
GEC_INTERNAL_SECRET=<long-random-string>
